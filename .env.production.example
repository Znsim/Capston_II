ENVIRONMENT=production
APP_DEBUG=false
ALLOWED_ORIGINS=https://kiosk.example.com

ADMIN_PASSWORD=replace-with-a-strong-password-of-12-or-more-characters
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=28800

REACT_APP_KIOSK_DEVICE_ID=SEOUL_01

# 권장 단일 장비 정책: SQLite + worker 1개
SQLITE_PATH=data/kiosk.db
UVICORN_WORKERS=1
BIND_HOST=127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# 중앙 MySQL 사용 시 아래 항목을 활성화하고 SQLite 경로는 무시한다.
# DB_USER=kiosk
# DB_PASSWORD=replace-with-a-database-password
# DB_HOST=db.example.internal
# DB_PORT=3306
# DB_NAME=kiosk_db

CONFIDENCE_THRESHOLD=0.80
MODEL_PATH=app/ai/models/gesture_model.pkl
LABEL_ENCODER_PATH=app/ai/models/label_encoder.pkl
MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=INFO
