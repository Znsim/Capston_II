# Application
ENVIRONMENT=development
APP_DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# Staff authentication (server only; never use a REACT_APP_ prefix)
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Kiosk frontend (public configuration)
REACT_APP_KIOSK_DEVICE_ID=SEOUL_01
SQLITE_PATH=kiosk.db
UVICORN_WORKERS=1
BIND_HOST=127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional MySQL configuration. Omit all of these to use SQLite.
# DB_USER=root
# DB_PASSWORD=replace-with-database-password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=kiosk_db

# AI
CONFIDENCE_THRESHOLD=0.80
MODEL_PATH=app/ai/models/gesture_model.pkl
LABEL_ENCODER_PATH=app/ai/models/label_encoder.pkl

# Request limit
MAX_REQUEST_BODY_BYTES=1048576
